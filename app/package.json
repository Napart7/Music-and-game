{
  "name": "glasslyrics",
  "version": "1.5.2",
  "description": "Cross-game transparent lyric overlay. No injection, no game memory access.",
  "homepage": "https://github.com/Napart7/Music-and-game",
  "main": "main.js",
  "author": {
    "name": "GlassLyrics contributors",
    "email": "glasslyrics@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "cn.glasslyrics.overlay",
    "productName": "GlassLyrics",
    "copyright": "MIT License",
    "directories": { "output": "../dist" },
    "files": [
      "main.js",
      "preload.js",
      "tray-preload.js",
      "tray-panel.html",
      "playback-clock.js",
      "lyrics.js",
      "providers.js",
      "window-classify.js",
      "changelog.json",
      "backends/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "smtc-bridge.ps1", "to": "smtc-bridge.ps1" },
      { "from": "smtc-control.ps1", "to": "smtc-control.ps1" },
      { "from": "window-probe.ps1", "to": "window-probe.ps1" },
      { "from": "backends", "to": "backends" }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "mac": {
      "icon": "assets/icon-512.png",
      "category": "public.app-category.music",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "linux": {
      "icon": "assets/icon-512.png",
      "category": "AudioVideo",
      "synopsis": "Cross-game lyric overlay",
      "maintainer": "GlassLyrics contributors <glasslyrics@users.noreply.github.com>",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GlassLyrics"
    },
    "portable": { "artifactName": "GlassLyrics-Portable.exe" }
  }
}
